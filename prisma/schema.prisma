generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  dine_in
  delivery
}

enum PriceCurrency {
  USD
  QAR
}

/// Google-authenticated account — only sign-in method in MVP.
model User {
  id        String       @id @default(cuid())
  googleId  String       @unique
  email     String       @unique
  name      String
  avatarUrl String?
  createdAt DateTime     @default(now())
  reviews   Review[]
  likes     ReviewLike[]
  bookmarks ReviewBookmark[]
}

/// Restaurant visit review — owned by a user.
model Review {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  excerpt     String
  body        String
  placeName   String
  serviceType ServiceType
  partySize   Int?
  meals       Json
  nutrition   Json?
  currency    PriceCurrency
  totalAmount Float?
  rating      Int
  cuisineTags String[]
  foodTypeTags String[]    @default([])
  imageUrls   String[]
  likeCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  likes       ReviewLike[]
  bookmarks   ReviewBookmark[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

/// A single user's like on a review — one row per (user, review).
model ReviewLike {
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
  @@index([reviewId])
}

/// A user's saved/bookmarked review — one row per (user, review).
model ReviewBookmark {
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
  @@index([reviewId])
}
